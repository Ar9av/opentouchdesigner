{
  "name": "tunnel",
  "group": "Looks",
  "prompt": "a slow feedback tunnel: sparse bright wisps of noise, tinted cyan to magenta, flying forward",
  "needs": "none",
  "notes": "Noise crushed to wisps, tinted by a ramp, fed into a feedback loop that zooms and rotates a little each frame. decay1.brightness is trail length, zoom1.scale is speed.",
  "nodes": [
    {"name": "noise1", "op": "noiseTOP", "pos": [0, -150],
     "params": {"period": 0.22, "harmonics": 6, "monochrome": true},
     "expressions": {"translate": "absTime * 0.06"}},
    {"name": "wisps1", "op": "levelTOP", "pos": [200, -150],
     "params": {"blacklevel": 0.42, "contrast": 2.4, "brightness": 1.9}},
    {"name": "palette1", "op": "rampTOP", "pos": [0, 0],
     "params": {"color1": [0.15, 0.95, 0.9, 1.0], "color2": [0.95, 0.25, 0.7, 1.0]},
     "expressions": {"phase": "absTime * 0.05"}},
    {"name": "tint1", "op": "compositeTOP", "pos": [400, -90], "params": {"operation": "multiply"}},
    {"name": "fb1", "op": "feedbackTOP", "pos": [200, 180], "params": {"target": "out1"}},
    {"name": "decay1", "op": "levelTOP", "pos": [400, 180], "params": {"brightness": 0.965}},
    {"name": "zoom1", "op": "transformTOP", "pos": [600, 180], "params": {"scale": [1.035, 1.035], "rotate": 0.8}},
    {"name": "mix1", "op": "compositeTOP", "pos": [800, 40], "params": {"operation": "maximum"}},
    {"name": "out1", "op": "nullTOP", "pos": [1000, 40]}
  ],
  "connections": [
    {"from": "noise1", "to": "wisps1", "input": 0},
    {"from": "wisps1", "to": "tint1", "input": 0},
    {"from": "palette1", "to": "tint1", "input": 1},
    {"from": "fb1", "to": "decay1", "input": 0},
    {"from": "decay1", "to": "zoom1", "input": 0},
    {"from": "tint1", "to": "mix1", "input": 0},
    {"from": "zoom1", "to": "mix1", "input": 1},
    {"from": "mix1", "to": "out1", "input": 0}
  ],
  "viewer": "out1"
}
