{
  "name": "audio",
  "group": "Audio",
  "prompt": "something that reacts to the microphone: trails that lurch forward on the bass",
  "needs": "none",
  "notes": "Mic -> spectrum -> lag -> the bass band, scaled into a zoom factor and exported onto drift1.scale, inside a feedback loop over colour noise. lag1.lagdown is how slowly it settles; zoom.gain how hard it kicks.",
  "nodes": [
    {"name": "audioin1", "op": "audiodeviceinCHOP", "pos": [0, 300]},
    {"name": "spectrum1", "op": "audiospectrumCHOP", "pos": [200, 300], "params": {"bands": 4, "gain": 30}},
    {"name": "lag1", "op": "lagCHOP", "pos": [400, 300], "params": {"lagup": 0.01, "lagdown": 0.2}},
    {"name": "bass", "op": "selectCHOP", "pos": [600, 300], "params": {"channels": "band1", "rename": "bass"}},
    {"name": "zoom", "op": "mathCHOP", "pos": [800, 300],
     "params": {"gain": 0.12, "offset": 1.0, "clamp": true, "clampmin": 1.0, "clampmax": 1.25}},
    {"name": "noise1", "op": "noiseTOP", "pos": [0, 0],
     "params": {"period": 0.3, "monochrome": false}, "expressions": {"translate": "absTime * 0.1"}},
    {"name": "fb1", "op": "feedbackTOP", "pos": [200, 140], "params": {"target": "out1"}},
    {"name": "decay1", "op": "levelTOP", "pos": [400, 140], "params": {"brightness": 0.92}},
    {"name": "drift1", "op": "transformTOP", "pos": [600, 140], "exports": {"scale": "zoom:bass"}},
    {"name": "mix1", "op": "compositeTOP", "pos": [800, 0], "params": {"operation": "maximum"}},
    {"name": "out1", "op": "nullTOP", "pos": [1000, 0]}
  ],
  "connections": [
    {"from": "audioin1", "to": "spectrum1", "input": 0},
    {"from": "spectrum1", "to": "lag1", "input": 0},
    {"from": "lag1", "to": "bass", "input": 0},
    {"from": "bass", "to": "zoom", "input": 0},
    {"from": "noise1", "to": "mix1", "input": 0},
    {"from": "fb1", "to": "decay1", "input": 0},
    {"from": "decay1", "to": "drift1", "input": 0},
    {"from": "drift1", "to": "mix1", "input": 1},
    {"from": "mix1", "to": "out1", "input": 0}
  ],
  "viewer": "out1"
}
