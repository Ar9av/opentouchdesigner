{
  "name": "torus",
  "group": "3D",
  "prompt": "a spinning 3d torus, lit, rendered to a texture, with a little bloom",
  "needs": "none",
  "notes": "Four nodes reference each other and only one wire runs: geo1 draws torus1 with mat1, render1 draws geo1 through cam1 under light1. Then bloom: crush to highlights, blur wide, add back.",
  "nodes": [
    {"name": "torus1", "op": "torusSOP", "pos": [0, 0]},
    {"name": "mat1", "op": "pbrMAT", "pos": [0, 140], "params": {"basecolor": [0.9, 0.5, 0.2, 1.0], "roughness": 0.3, "metallic": 0.7}},
    {"name": "geo1", "op": "geometryCOMP", "pos": [200, 0],
     "params": {"sop": "torus1", "material": "mat1"},
     "expressions": {"rotate": "[absTime * 20.0, absTime * 35.0, 0.0]"}},
    {"name": "cam1", "op": "cameraCOMP", "pos": [200, 140], "params": {"translate": [0.0, 1.5, 5.0], "lookat": "geo1"}},
    {"name": "light1", "op": "lightCOMP", "pos": [200, 280], "params": {"translate": [3.0, 5.0, 4.0], "intensity": 1.3}},
    {"name": "render1", "op": "renderTOP", "pos": [400, 0],
     "params": {"geometry": "geo1", "camera": "cam1", "light": "light1", "background": [0.02, 0.02, 0.04, 1.0]}},
    {"name": "bright1", "op": "levelTOP", "pos": [600, 140], "params": {"blacklevel": 0.55}},
    {"name": "bloom1", "op": "blurTOP", "pos": [800, 140], "params": {"size": 26}},
    {"name": "comp1", "op": "compositeTOP", "pos": [1000, 0], "params": {"operation": "add"}},
    {"name": "out1", "op": "nullTOP", "pos": [1200, 0]}
  ],
  "connections": [
    {"from": "render1", "to": "bright1", "input": 0},
    {"from": "bright1", "to": "bloom1", "input": 0},
    {"from": "render1", "to": "comp1", "input": 0},
    {"from": "bloom1", "to": "comp1", "input": 1},
    {"from": "comp1", "to": "out1", "input": 0}
  ],
  "viewer": "out1"
}
