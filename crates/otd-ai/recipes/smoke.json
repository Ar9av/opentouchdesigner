{
  "name": "smoke",
  "group": "Video",
  "prompt": "make the video dissolve into drifting smoke",
  "needs": "video",
  "notes": "A flow loop as a crossfade: fb1 reads out1's last frame, flow1 advects it along curl noise, mix1 lays that over the clip at 90% so each frame is mostly the smeared history. flow1.amount is how far it drifts per frame; mix1.opacity is how long the picture takes to dissolve (higher = longer).",
  "nodes": [
    {
      "name": "fb1",
      "op": "feedbackTOP",
      "pos": [
        0,
        160
      ],
      "params": {
        "target": "out1"
      }
    },
    {
      "name": "flow1",
      "op": "flowTOP",
      "pos": [
        200,
        160
      ],
      "params": {
        "amount": 8,
        "scale": 3,
        "speed": 0.3
      }
    },
    {
      "name": "mix1",
      "op": "compositeTOP",
      "pos": [
        400,
        0
      ],
      "params": {
        "operation": "over",
        "opacity": 0.9
      }
    },
    {
      "name": "out1",
      "op": "nullTOP",
      "pos": [
        600,
        0
      ]
    }
  ],
  "connections": [
    {
      "from": "source1",
      "to": "mix1",
      "input": 0
    },
    {
      "from": "fb1",
      "to": "flow1",
      "input": 0
    },
    {
      "from": "flow1",
      "to": "mix1",
      "input": 1
    },
    {
      "from": "mix1",
      "to": "out1",
      "input": 0
    }
  ],
  "viewer": "out1"
}
