# Copy to .env and fill in whichever you have. .env is gitignored.
# The editor also has a key field (File → ✨ Assistant) which stores keys in
# a 0600 file outside every project — the environment is the alternative for
# CI and show machines, not a requirement.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
