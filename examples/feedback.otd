(
  format: "opentouchdesigner-project",
  version: 1,
  fps: 60.0,
  nodes: [
    (
      path: "/comp1",
      op: "compositeTOP",
      pos: (200.0, -80.0),
      inputs: [
        "/glsl1",
        "/xform1",
      ],
      params: {
        "operation": (
          value: Str("maximum"),
        ),
      },
    ),
    (
      path: "/decay1",
      op: "levelTOP",
      pos: (-220.0, 20.0),
      inputs: [
        "/fb1",
      ],
      params: {
        "brightness": (
          value: Float(0.94),
        ),
      },
    ),
    (
      path: "/fb1",
      op: "feedbackTOP",
      pos: (-420.0, 20.0),
      params: {
        "target": (
          value: Str("/out1"),
        ),
      },
    ),
    (
      path: "/glsl1",
      op: "glslTOP",
      pos: (-420.0, -180.0),
      params: {
        "language": (
          value: Str("glsl"),
        ),
        "source": (
          value: Str("void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n    vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;\n    float t = iTime;\n    vec3 col = vec3(0.0);\n    for (int i = 0; i < 3; i++) {\n        float fi = float(i);\n        vec2 p = uv * (1.0 + fi * 0.35);\n        p += 0.34 * vec2(cos(t * 0.7 + fi * 1.7), sin(t * 0.9 + fi * 2.3));\n        float d = length(p);\n        float ring = smoothstep(0.14, 0.0, abs(d - 0.16 - 0.04 * sin(t * 1.3 + fi)));\n        col += ring * vec3(0.55 + 0.45 * sin(fi * 2.1 + t), 0.35 + 0.2 * fi, 1.0 - 0.25 * fi);\n    }\n    fragColor = vec4(col, 1.0);\n}\n"),
        ),
        "resw": (
          value: Int(1920),
        ),
        "resh": (
          value: Int(1080),
        ),
      },
    ),
    (
      path: "/out1",
      op: "nullTOP",
      pos: (420.0, -80.0),
      inputs: [
        "/comp1",
      ],
    ),
    (
      path: "/xform1",
      op: "transformTOP",
      pos: (-20.0, 20.0),
      inputs: [
        "/decay1",
      ],
      params: {
        "rotate": (
          value: Float(0.45),
        ),
        "scale": (
          value: Vec2((1.028, 1.028)),
        ),
      },
    ),
  ],
)
